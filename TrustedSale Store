<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Meesho Reselling Store</title>
    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f7f7f7;
        }
        header {
            background: #0066ff;
            color: white;
            padding: 15px;
            text-align: center;
            font-size: 24px;
            font-weight: bold;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }
        #logo {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            font-weight: bold;
            color: #0066ff;
        }
        #cartIcon {
            position: absolute;
            right: 20px;
            top: 15px;
            cursor: pointer;
            font-size: 18px;
            background: white;
            color: #0066ff;
            padding: 6px 12px;
            border-radius: 20px;
            font-weight: bold;
        }
        .banner {
            width: 100%;
            height: 180px;
            background: url('https://via.placeholder.com/1200x300?text=TrustedSale+Store+Mega+Sale') no-repeat center;
            background-size: cover;
            border-bottom: 3px solid #0066ff;
        }
        .container {
            width: 92%;
            margin: auto;
            padding: 20px 0;
        }
        .products {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 15px;
        }
        .product-card {
            background: white;
            border-radius: 10px;
            padding: 12px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            text-align: center;
        }
        .product-card img {
            width: 100%;
            height: 220px;
            object-fit: cover;
            border-radius: 10px;
        }
        .product-card button {
            background: #0066ff;
            color: white;
            border: none;
            padding: 10px 15px;
            border-radius: 5px;
            cursor: pointer;
            font-size: 16px;
        }
        /* CART */
        .cart-box {
            position: fixed;
            top: 0;
            right: -400px;
            width: 330px;
            height: 100%;
            background: white;
            box-shadow: -3px 0 6px rgba(0,0,0,0.2);
            padding: 20px;
            transition: 0.3s;
            overflow-y: auto;
        }
        .cart-item {
            padding: 10px;
            border-bottom: 1px solid #ddd;
        }
        .checkout {
            background: #0066ff;
            color: white;
            padding: 10px;
            text-align: center;
            margin-top: 20px;
            border-radius: 5px;
            cursor: pointer;
        }
        footer {
            background: #1a1a1a;
            color: white;
            text-align: center;
            padding: 15px;
            margin-top: 30px;
            font-size: 14px;
        }

        /* MOBILE SMOOTH RESPONSIVE */
        @media(max-width: 600px) {
            header {
                font-size: 20px;
                padding: 10px;
            }
            #cartIcon {
                top: 10px;
                right: 10px;
                padding: 5px 10px;
                font-size: 14px;
            }
            .banner {
                height: 140px;
            }
            .product-card img {
                height: 180px;
            }
            .cart-box {
                width: 100%;
            }
        }
    </style>
</head>
<body>
    <header>
        <div id="logo">TS</div>
        TrustedSale Store
        <div id="cartIcon" onclick="toggleCart()">🛒 (<span id="cartCount">0</span>)</div>
    </header>

    <div class="banner"></div>

    <div class="container">
        <h2>Latest Products</h2>
        <div class="products">

            <div class="product-card">
                <img src="https://via.placeholder.com/300">
                <h3>Smart Gadget</h3>
                <p>₹499</p>
                <button onclick="addToCart('Smart Gadget', 499)">Add to Cart</button>
            </div>

            <div class="product-card">
                <img src="https://via.placeholder.com/300">
                <h3>Mini Dishwasher</h3>
                <p>₹1499</p>
                <button onclick="addToCart('Mini Dishwasher', 1499)">Add to Cart</button>
            </div>

            <div class="product-card">
                <img src="https://via.placeholder.com/300">
                <h3>Stylish Locket</h3>
                <p>₹299</p>
                <button onclick="addToCart('Stylish Locket', 299)">Add to Cart</button>
            </div>

            <div class="product-card">
                <img src="https://via.placeholder.com/300">
                <h3>Elegant Necklace</h3>
                <p>₹399</p>
                <button onclick="addToCart('Elegant Necklace', 399)">Add to Cart</button>
            </div>

        </div>
    </div>

    <div id="cartBox" class="cart-box">
        <h2>Your Cart</h2>
        <div id="cartItems"></div>
        <div class="checkout" onclick="checkout()">Checkout on WhatsApp</div>
    </div>

    <script>
        let cart = [];

        function addToCart(name, price) {
            cart.push({ name, price });
            document.getElementById('cartCount').innerText = cart.length;
            updateCartUI();
        }

        function toggleCart() {
            const cartBox = document.getElementById('cartBox');
            cartBox.style.right = cartBox.style.right === '0px' ? '-400px' : '0px';
        }

        function updateCartUI() {
            const cartItems = document.getElementById('cartItems');
            cartItems.innerHTML = '';
            cart.forEach(item => {
                cartItems.innerHTML += `<div class='cart-item'>${item.name} - ₹${item.price}</div>`;
            });
        }

        function checkout() {
            let phone = '+919692491403';
            let message = 'Hello! I want to order these items:%0A';
            cart.forEach(item => {
                message += `- ${item.name} (₹${item.price})%0A`;
            });
            window.open(`https://wa.me/${phone}?text=${message}`, '_blank');
        }
    </script>
</body>
</html>
